# =====================================================================
# Agency Growth Automation Platform - environment template
# Copy to `apps/web/.env.local` for the browser-exposed values and
# export (or `.env.local` at the repo root) for worker/service values.
# NEVER commit real credentials. This file contains placeholders only.
# =====================================================================

# ---- Browser (NEXT_PUBLIC_*) - safe to expose, RLS-scoped ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_ENABLE_DISCOVERY_CAMPAIGNS=false
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_ENABLE_RESEARCH=false
NEXT_PUBLIC_ENABLE_PERSONALIZED_AI=false
NEXT_PUBLIC_ENABLE_VIBE_AI=false

# ---- Supabase service connection (server/workers only) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Edge worker auth ----
# Shared secret used by cron workers to call Edge Functions.
# Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET=your-generated-cron-secret
# Optional second secret accepted by research-preview-jobs.
RESEARCH_PREVIEW_RUN_SECRET=your-generated-preview-secret
# Optional browser-admin allowlist for the Campaigns dashboard.
ALLOWED_ORIGIN=https://your-frontend.example.com

# ---- Discovery providers (all disabled by default) ----
# Serper: https://serper.dev (synthetic examples only)
SERPER_API_KEY=your-serper-key
ENABLE_SERPER_DISCOVERY=false            # permanent default
# Harvey OSM provider awareness (experimental, not production-ready)
ENABLE_HARVEY_OSM_DISCOVERY=false
# Tavily (optional research adapter, not configured by default)
# TAVILY_API_KEY=your-tavily-key
# ENABLE_TAVILY_RESEARCH=false

# ---- Research & previews (all disabled by default) ----
RESEARCH_PROVIDER=serper
ENABLE_RESEARCH_PREVIEW_JOBS=false
ENABLE_RESEARCH_PREVIEW_AI=false
AI_PREVIEW_MAX_CALLS=0

# ---- Intake handoff (all disabled by default) ----
ENABLE_INTAKE_HANDOFF=false
ENABLE_INTAKE_HANDOFF_BATCH=false
ENABLE_INTAKE_HANDOFF_RECONCILE=false
INTAKE_HANDOFF_BATCH_SIZE=10
INTAKE_HANDOFF_LEASE_TTL_MIN=5
INTAKE_HANDOFF_MAX_ATTEMPTS=3

# ---- Campaign continuation (disabled by default; keep OFF) ----
ENABLE_CAMPAIGN_CONTINUATION=false
CAMPAIGN_CONTINUATION_MAX_PAGES=20
CAMPAIGN_CONTINUATION_MAX_DURATION_MS=600000
CAMPAIGN_CONTINUATION_DELAY_MS=2000

# ---- Email / Gmail (all disabled by default) ----
# OAuth: https://console.cloud.google.com (Gmail read scope for sandbox accounts)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-frontend.example.com/onboard/
# Only a comma-separated list of sandbox admin addresses may use Gmail.
GOOGLE_ALLOWED_TEST_EMAILS=you@example.com
GOOGLE_SANDBOX_ONLY=true
# Live sending requires ALL of the following to be explicitly enabled:
ENABLE_GMAIL_SYNC=false
ENABLE_GMAIL_BACKLOG=false
ENABLE_EMAIL_VERIFICATION=false
ENABLE_EMAIL_SEQUENCES=false
ENABLE_LIVE_EMAIL=false
# Outbound webhook signing for inbound email events (if used)
SUPPRESSION_HMAC_SECRET=your-generated-suppression-secret
# Optional transactional sending via Resend (via Reacher, self-hosted)
REACHER_ENDPOINT=https://your-reacher-instance.example.com
REACHER_TOKEN=your-reacher-token
ENABLE_REACHER_SMTP=false

# ---- AI providers (optional, disabled by default) ----
GROQ_API_KEY=your-groq-key
ENABLE_PERSONALIZED_AI=false
ENABLE_VIBE_AI=false

# ---- Website audit (disabled by default) ----
ENABLE_WEBSITE_AUDIT=false

# ---- WhatsApp (disabled by default) ----
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_CONNECTION_ID=your-connection-id

# ---- Token encryption for stored provider credentials (server only) ----
TOKEN_ENCRYPTION_KEY=your-256-bit-hex-key

# ---- Vibe prospecting (optional, disabled by default) ----
# VIBE_PROSPECTING_API_KEY=your-vibe-key
# ENABLE_VIBE_CONTACT_DISCOVERY=false
